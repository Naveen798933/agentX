# ==============================================================================
# AI Virtual Software House / PULSE Collaborative Workspace - Environment Config
# ==============================================================================
# Copy this file to .env and supply your environment-specific credentials.
# NEVER commit your real .env file or credentials to source control.

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=INFO
# CORS allowed origin (set to your domain in production e.g. https://pulse.domain.com, leave empty or * for wildcard)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. LLM GATEWAY (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Gemini API Key (Required for live generation)
GEMINI_API_KEY=
# Primary model for parsing, synthesis, and repair
GEMINI_MODEL=gemini-3.5-flash-lite
# Resilient fallback model when primary experiences rate limits or downtime
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Token rate limiter ceiling (Requests per minute per IP/tenant)
GEMINI_RPM_LIMIT=14

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & RBAC
# ------------------------------------------------------------------------------
# Set to 'true' in staging/production to enforce JWT authentication and RBAC checks
AUTH_ENABLED=false
# Secret key used for HMAC-SHA256 JWT signature verification
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars
# Cookie security flag (defaults to true in production)
SECURE_COOKIES=false

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Supported adapters: 'sqlite' (embedded WAL) or 'postgres' (enterprise)
DATABASE_ADAPTER=sqlite

# PostgreSQL Configuration (used when DATABASE_ADAPTER=postgres)
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pulse_workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_POOL_MAX=10
POSTGRES_SSL=false

# ------------------------------------------------------------------------------
# 5. ASYNC WORKERS & QUEUES (REDIS / BULLMQ)
# ------------------------------------------------------------------------------
# Set to 'true' to dispatch autonomous generation and deployments to BullMQ workers
ASYNC_GENERATION_ENABLED=false
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false
QUEUE_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 6. SANDBOX EXECUTION ENGINE
# ------------------------------------------------------------------------------
# Backend mode: 'AUTO' (attempts Docker, falls back to PROCESS_JAIL), 'DOCKER', or 'PROCESS_JAIL'
SANDBOX_BACKEND=AUTO
SANDBOX_DOCKER_IMAGE=node:22-alpine
# When true, strictly refuses execution if Docker daemon is unreachable
SANDBOX_STRICT_ISOLATION=false
# When true, permits host process jail fallback if Docker is offline
SANDBOX_ALLOW_HOST_FALLBACK=true

# ------------------------------------------------------------------------------
# 7. ARTIFACT & OBJECT STORAGE
# ------------------------------------------------------------------------------
# Storage provider: 'local' (disk storage) or 's3' (AWS S3, MinIO, Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data/artifacts
STORAGE_SIGNING_SECRET=replace-with-a-secure-random-signing-secret

# S3 Configuration (used when STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=virtual-house-artifacts
STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY DEPLOYMENT INTEGRATIONS
# ------------------------------------------------------------------------------
# Vercel Deployment Provider
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Cloudflare Pages Provider
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY & ERROR TRACKING
# ------------------------------------------------------------------------------
# Sentry DSN for remote error reporting
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 10. BILLING & USAGE METERING (STRIPE)
# ------------------------------------------------------------------------------
BILLING_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
